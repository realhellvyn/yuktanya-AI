# Copy to .env.local; never commit actual secrets
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FREELLM_BASE_URL=
FREELLM_API_KEY=
# All model calls use literal model: "auto" in server code (no model env override)
# Local mock for tests/development only
AI_MOCK_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI upload/pre-review must remain disabled until quota + privacy approval
AI_PREREVIEW_ENABLED=false

DATABASE_URL=

# Ekspor dokumen (pengembangan: berkas lokal; produksi: bucket privat Supabase)
DOCUMENT_BLOB_DIR=.data/blobs
SUPABASE_STORAGE_BUCKET=documents
# Hanya di luar produksi; produksi selalu menolak template yang belum disetujui
ALLOW_UNAPPROVED_TEMPLATES=false

# Penjadwal (cron) memanggil /api/jobs/outbox, /api/jobs/retention, dan /api/jobs/expire-orders dengan header
# "Authorization: Bearer $CRON_SECRET" (minimal 16 karakter).
CRON_SECRET=

# Pembayaran: hanya adapter mock (non-produksi) dan transfer manual yang tersedia. Gateway nyata belum dipilih.
# Teks instruksi transfer yang ditampilkan di halaman pembayaran (kosong = "Instruksi pembayaran belum tersedia").
MANUAL_PAYMENT_INSTRUCTIONS=
# Penerbit dan ruang lingkup di halaman verifikasi publik tetap dimatikan sampai persetujuan privasi (diatur lewat tabel app_settings).
PUBLIC_ISSUER_DISCLOSURE=off

# Deep Review dan Enhanced: default OFF di produksi. Enhanced juga memerlukan persetujuan rubrik mitra (lihat /admin/rubric).
DEEP_REVIEW_PURCHASE=false
ENHANCED_ISSUANCE=false
NEXT_PUBLIC_GOOGLE_AUTH=false
