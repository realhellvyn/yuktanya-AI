# Copy to .env.local; never commit actual secrets
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FREELLM_BASE_URL=
FREELLM_API_KEY=
# All model calls use literal model: "auto" in server code (no model env override)
# Local mock for tests/development only
AI_MOCK_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI upload/pre-review must remain disabled until quota + privacy approval
AI_PREREVIEW_ENABLED=false

DATABASE_URL=

# Ekspor dokumen (pengembangan: berkas lokal; produksi: bucket privat Supabase)
DOCUMENT_BLOB_DIR=.data/blobs
SUPABASE_STORAGE_BUCKET=documents
# Hanya di luar produksi; produksi selalu menolak template yang belum disetujui
ALLOW_UNAPPROVED_TEMPLATES=false
